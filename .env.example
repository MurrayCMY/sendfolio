# SendFolio configuration. Copy to .env (or run `npm run init`, which does it for you).
# Real environment variables always win over this file, so on Docker / Netlify / Railway you set these in the dashboard.

# ───────────── Required ─────────────
# Secret used to sign login cookies and tokens. 32+ random characters. `npm run init` generates one.
SESSION_SECRET=
# The only address allowed to sign in to /admin (a 6-digit code is emailed to it).
ADMIN_EMAIL=
# The public address of your site, no trailing slash. Used for links inside emails.
SITE_URL=http://localhost:8787

# ───────────── Branding & language ─────────────
# Shown in the UI, emails and NDA PDFs.
APP_NAME=SendFolio
# Legal or display name used in the NDA and confirmation emails. Defaults to APP_NAME.
COMPANY_NAME=
# Accent colour used in emails (the web UI colours are in src/styles.css and src/admin/admin.css).
BRAND_COLOR=#3949AB
# Language of the admin and of emails to you, until someone picks another: en | zh
DEFAULT_LOCALE=en
# IANA time zone for dates in the admin, emails and watermarks, e.g. UTC, America/New_York, Asia/Shanghai.
TIMEZONE=UTC

# ───────────── Email (SMTP) ─────────────
# Needed so visitors get their verification codes and NDA copies. Without it, emails (including your admin
# login code) are printed in the server log instead of being sent, which is fine for trying things out.
#
#   Resend    SMTP_HOST=smtp.resend.com     SMTP_PORT=465  SMTP_USER=resend          SMTP_PASS=<API key>
#   Gmail     SMTP_HOST=smtp.gmail.com      SMTP_PORT=465  SMTP_USER=you@gmail.com   SMTP_PASS=<app password>
#   Postmark  SMTP_HOST=smtp.postmarkapp.com SMTP_PORT=587 SMTP_USER=<token>         SMTP_PASS=<token>
#   Amazon SES, Mailgun, Brevo, your own server ... anything that speaks SMTP works.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# The "From" address, e.g. SendFolio <docs@yourdomain.com>. Must be allowed by your SMTP provider.
MAIL_FROM=
# Optional: also send every NDA confirmation to this address (a copy for your records).
MAIL_BCC=

# ───────────── Self-hosting (Docker / VPS) ─────────────
PORT=8787
# PostgreSQL connection string. Leave empty to use the embedded PGlite database in ./data/pglite
# (fine for trying it out and small deployments; use Postgres for anything you care about).
# Example: postgres://sendfolio:password@db:5432/sendfolio
DATABASE_URL=
# Where uploaded PDFs and page images are stored.
STORAGE_DIR=./data/files
# Set to true when the app runs behind a reverse proxy or CDN (Caddy, nginx, Cloudflare ...), so the real
# visitor IP is taken from X-Forwarded-For. Leave false if the app is exposed directly.
TRUST_PROXY=false
# Send Strict-Transport-Security. Turn on once your site is served over HTTPS.
HSTS=false
